# Server Port & Runtime Environment
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/rural_health_link

# Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# CORS & Domain Configuration (Provider-Agnostic)
# Primary frontend URL (HTTPS in production)
CLIENT_ORIGIN=http://localhost:3000
# Comma-separated list of additional allowed origins for CORS and Socket.IO
# Examples: https://health.yourdomain.com,https://api.yourdomain.com,*.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000

# Reverse Proxy / Ingress Configuration (Provider-Agnostic)
# Set to 'true', '1', or number of proxy hops if running behind Nginx, Caddy, Cloudflare, Traefik, AWS ALB, etc.
TRUST_PROXY=true

# Optional Native HTTPS (if not using an external TLS-terminating reverse proxy)
# Set to 'true' to enable native Node.js TLS listener with certificates below
HTTPS_ENABLED=false
SSL_KEY_PATH=
SSL_CERT_PATH=

# AI & LLM Service Credentials (Provider-Agnostic)
GROQ_API_KEY=
SARVAM_API_KEY=

# WebRTC STUN/TURN Configuration (Production-Safe Ephemeral Credentials)
# STUN Servers (Comma-separated, used for direct P2P NAT discovery)
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN Relay Servers (Comma-separated, used ONLY as relay fallback when direct P2P fails)
# Example: turns:turn.yourdomain.com:5349?transport=tcp,turn:turn.yourdomain.com:3478?transport=udp
TURN_SERVER_URLS=

# TURN Ephemeral Credential Secret (RFC 5766 / coturn / TURN REST API shared secret)
# The backend uses this secret to generate short-lived HMAC-SHA1 tokens.
# Permanent TURN credentials are NEVER exposed to the frontend.
TURN_SECRET=
TURN_TTL_SECONDS=86400
